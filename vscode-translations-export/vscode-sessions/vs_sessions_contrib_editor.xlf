  <file original="src/vs/sessions/contrib/editor/browser/emptyFileEditorAccessibility" source-language="en" datatype="plaintext"><body>
    <trans-unit id="emptyFileEditor.searchHelp.dismiss">
      <source xml:lang="en">Press Escape to close the search results and return to the Files editor.</source>
    </trans-unit>
    <trans-unit id="emptyFileEditor.searchHelp.inlineSearch">
      <source xml:lang="en">Type part of a file name in the search field to search the active session workspace. Use Up Arrow and Down Arrow to choose a result, and Enter to open it. Press Escape to clear the search and return to the search field.</source>
    </trans-unit>
    <trans-unit id="emptyFileEditor.searchHelp.open">
      <source xml:lang="en">Open File searches the active session workspace. Type part of a file name, use Up Arrow and Down Arrow to choose a result, and press Enter to open it.</source>
    </trans-unit>
    <trans-unit id="emptyFileEditor.searchHelp.overview">
      <source xml:lang="en">The Files editor offers a search field, followed by Open File and New File actions. Use Tab to reach the search field and actions. Use Up Arrow or Down Arrow to move between actions and Enter or Space to run one.</source>
    </trans-unit>
</body></file>
