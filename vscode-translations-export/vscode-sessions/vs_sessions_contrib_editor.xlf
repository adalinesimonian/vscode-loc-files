    <trans-unit id="sessions.diffEditor.wordWrap">
      <source xml:lang="en">Controls how diff editors in the Agents window wrap lines.</source>
    </trans-unit>
    <trans-unit id="sessions.diffEditor.wordWrap.inherit">
      <source xml:lang="en">Lines will wrap according to the {0} setting.</source>
    </trans-unit>
    <trans-unit id="sessions.diffEditor.wordWrap.off">
      <source xml:lang="en">Lines will never wrap.</source>
    </trans-unit>
    <trans-unit id="sessions.diffEditor.wordWrap.on">
      <source xml:lang="en">Lines will wrap at the viewport width.</source>
    </trans-unit>
