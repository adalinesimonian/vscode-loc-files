      <source xml:lang="en">Pick a streak scenario to simulate</source>
    </trans-unit>
    <trans-unit id="aquarium.toggleActionVisibility">
      <source xml:lang="en">Toggle Aquarium Action Visibility</source>
    </trans-unit>
    <trans-unit id="sessions.developerJoy.enabled">
      <source xml:lang="en">Adds an easter egg to the Agents window.</source>
    </trans-unit>
</body></file>
