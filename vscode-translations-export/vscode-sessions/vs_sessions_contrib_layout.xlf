  <file original="src/vs/sessions/contrib/layout/browser/sessions.layout.contribution" source-language="en" datatype="plaintext"><body>
    <trans-unit id="sessions.layout.autoCollapseSessionsSidebar">
      <source xml:lang="en">Controls whether the sessions sidebar is automatically collapsed in a narrow Agents window while both the editor and the side panel are open, and shown again once either of them closes.</source>
    </trans-unit>
    <trans-unit id="sessions.layout.singlePaneDetailPanel">
      <source xml:lang="en">Controls whether the Agents window docks the detail panel inside the editor so a single editor tab bar spans across the editor and the detail panel. Requires a window reload to take effect.</source>
    </trans-unit>
</body></file>
