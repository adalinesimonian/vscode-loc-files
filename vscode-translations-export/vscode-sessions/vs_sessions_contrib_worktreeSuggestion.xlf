<?xml version="1.0" encoding="utf-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
  <file original="src/vs/sessions/contrib/worktreeSuggestion/browser/worktreeSuggestion.contribution" source-language="en" datatype="plaintext"><body>
    <trans-unit id="sessions.chat.worktreeSuggestion">
      <source xml:lang="en">Controls how a new session suggests a new worktree, in which the agent works on a separate copy of the files, when Branch is selected and the folder has uncommitted changes. Suggestions appear once you have started at least {0} sessions in the Agents window.</source>
    </trans-unit>
    <trans-unit id="sessions.chat.worktreeSuggestion.inlineHint">
      <source xml:lang="en">Show a hint below the input once you start typing, until you close it.</source>
    </trans-unit>
    <trans-unit id="sessions.chat.worktreeSuggestion.inlineHintLabel">
      <source xml:lang="en">Inline Hint</source>
    </trans-unit>
    <trans-unit id="sessions.chat.worktreeSuggestion.off">
      <source xml:lang="en">Don't suggest a new worktree.</source>
    </trans-unit>
    <trans-unit id="sessions.chat.worktreeSuggestion.offLabel">
      <source xml:lang="en">Off</source>
    </trans-unit>
    <trans-unit id="sessions.chat.worktreeSuggestion.spotlightOnSend">
      <source xml:lang="en">Spotlight the isolation picker once, when you send a request, offering to send it in a new worktree.</source>
    </trans-unit>
    <trans-unit id="sessions.chat.worktreeSuggestion.spotlightOnSendLabel">
      <source xml:lang="en">Spotlight on Send</source>
    </trans-unit>
    <trans-unit id="sessions.chat.worktreeSuggestion.uncommittedFilesCount">
      <source xml:lang="en">Show the number of uncommitted files after Branch in the isolation picker, which lists them.</source>
    </trans-unit>
    <trans-unit id="sessions.chat.worktreeSuggestion.uncommittedFilesCountLabel">
      <source xml:lang="en">Uncommitted Files Count</source>
    </trans-unit>
    <trans-unit id="sessions.worktreeSuggestion.preview">
      <source xml:lang="en">Preview Worktree Suggestion...</source>
    </trans-unit>
    <trans-unit id="sessions.worktreeSuggestion.preview.inlineHint">
      <source xml:lang="en">Inline Hint</source>
    </trans-unit>
    <trans-unit id="sessions.worktreeSuggestion.preview.inlineHintDetail">
      <source xml:lang="en">Shows a hint below the input once you start typing, which opens the isolation picker.</source>
    </trans-unit>
    <trans-unit id="sessions.worktreeSuggestion.preview.placeholder">
      <source xml:lang="en">Preview a worktree suggestion in this window, even if you closed or saw it before, or started too few sessions</source>
    </trans-unit>
    <trans-unit id="sessions.worktreeSuggestion.preview.spotlightOnSend">
      <source xml:lang="en">Spotlight on Send</source>
    </trans-unit>
    <trans-unit id="sessions.worktreeSuggestion.preview.spotlightOnSendDetail">
      <source xml:lang="en">Spotlights the isolation picker when you send a request.</source>
    </trans-unit>
    <trans-unit id="sessions.worktreeSuggestion.preview.stop">
      <source xml:lang="en">Stop Preview</source>
    </trans-unit>
    <trans-unit id="sessions.worktreeSuggestion.preview.stopDetail">
      <source xml:lang="en">Return to the configured setting.</source>
    </trans-unit>
    <trans-unit id="sessions.worktreeSuggestion.preview.uncommittedFilesCount">
      <source xml:lang="en">Uncommitted Files Count</source>
    </trans-unit>
    <trans-unit id="sessions.worktreeSuggestion.preview.uncommittedFilesCountDetail">
      <source xml:lang="en">Shows the number of uncommitted files after Branch, and lists them in the isolation picker.</source>
    </trans-unit>
    <trans-unit id="sessions.worktreeSuggestion.reset">
      <source xml:lang="en">Reset Worktree Suggestion State</source>
    </trans-unit>
</body></file>
  <file original="src/vs/sessions/contrib/worktreeSuggestion/browser/worktreeSuggestionController" source-language="en" datatype="plaintext"><body>
    <trans-unit id="worktreeSuggestion.inline.ariaLabel">
      <source xml:lang="en">Worktree suggestion</source>
    </trans-unit>
    <trans-unit id="worktreeSuggestion.inline.closeForGood">
      <source xml:lang="en">Close and Don't Show Again</source>
    </trans-unit>
</body></file>
  <file original="src/vs/sessions/contrib/worktreeSuggestion/browser/worktreeSuggestionPresentation" source-language="en" datatype="plaintext"><body>
    <trans-unit id="worktreeSuggestion.branchChangesPlural">
      <source xml:lang="en">{0} has {1} uncommitted files.</source>
    </trans-unit>
    <trans-unit id="worktreeSuggestion.branchChangesSingular">
      <source xml:lang="en">{0} has 1 uncommitted file.</source>
    </trans-unit>
    <trans-unit id="worktreeSuggestion.changedFileAria">
      <source xml:lang="en">{0}, {1} {2}</source>
    </trans-unit>
    <trans-unit id="worktreeSuggestion.changedFileAriaAtRoot">
      <source xml:lang="en">{0} {1}</source>
    </trans-unit>
    <trans-unit id="worktreeSuggestion.changedFiles.description">
      <source xml:lang="en">{0} On Branch, the agent works alongside them.</source>
    </trans-unit>
    <trans-unit id="worktreeSuggestion.changedFiles.header">
      <source xml:lang="en">{0} On Branch, the agent works alongside them, so its changes can mix with yours.</source>
    </trans-unit>
    <trans-unit id="worktreeSuggestion.copyHelp">
      <source xml:lang="en">When Branch is selected for a new session in a folder with uncommitted changes, the Agents window may suggest New Worktree, in which the agent works on a separate copy of the files, so it does not change your uncommitted files. Depending on the suggestion, it appears as a spotlight on the isolation picker when you send the request, whose Send in Worktree button switches to New Worktree before sending, and whose Send button or Escape sends on Branch; as a hint below the input once you start typing, whose Use Worktree button opens the isolation picker, whose close button hides it for good, and which Escape hides for the session; or as the number of uncommitted files after Branch in the isolation picker, which lists them when opened. Use Tab or Shift+Tab to reach the actions.</source>
    </trans-unit>
    <trans-unit id="worktreeSuggestion.folderChangesPlural">
      <source xml:lang="en">This folder has {0} uncommitted files.</source>
    </trans-unit>
    <trans-unit id="worktreeSuggestion.folderChangesSingular">
      <source xml:lang="en">This folder has 1 uncommitted file.</source>
    </trans-unit>
    <trans-unit id="worktreeSuggestion.inlineHintMessage">
      <source xml:lang="en">{0} Worktrees allow agents to run on a separate copy of the files.</source>
    </trans-unit>
    <trans-unit id="worktreeSuggestion.moreFiles">
      <source xml:lang="en">{0} more</source>
    </trans-unit>
    <trans-unit id="worktreeSuggestion.send">
      <source xml:lang="en">Send</source>
    </trans-unit>
    <trans-unit id="worktreeSuggestion.sendInWorktree">
      <source xml:lang="en">Send in Worktree</source>
    </trans-unit>
    <trans-unit id="worktreeSuggestion.uncommittedFilesSectionPlural">
      <source xml:lang="en">{0} Uncommitted Files</source>
    </trans-unit>
    <trans-unit id="worktreeSuggestion.uncommittedFilesSectionSingular">
      <source xml:lang="en">1 Uncommitted File</source>
    </trans-unit>
    <trans-unit id="worktreeSuggestion.useWorktree">
      <source xml:lang="en">Use Worktree</source>
    </trans-unit>
</body></file>
  <file original="src/vs/sessions/contrib/worktreeSuggestion/browser/worktreeSuggestionService" source-language="en" datatype="plaintext"><body>
    <trans-unit id="worktreeSuggestion.switchFailed">
      <source xml:lang="en">Couldn't switch this session to a new worktree. Choose New Worktree in the isolation picker instead.</source>
    </trans-unit>
    <trans-unit id="worktreeSuggestion.switched">
      <source xml:lang="en">This session will start in a new worktree.</source>
    </trans-unit>
</body></file>
