      <source xml:lang="en">Issue troubleshooting is active and has temporarily disabled all installed extensions. Check if you can still reproduce the problem and proceed by selecting from these options.</source>
    </trans-unit>
    <trans-unit id="report anyway">
      <source xml:lang="en">Report Issue Anyway</source>
    </trans-unit>
    <trans-unit id="stop">
      <source xml:lang="en">Stop</source>
    </trans-unit>
    <trans-unit id="title.stop">
      <source xml:lang="en">Stop Troubleshoot Issue</source>
    </trans-unit>
    <trans-unit id="troubleshoot issue">
      <source xml:lang="en">Troubleshoot Issue</source>
    </trans-unit>
    <trans-unit id="troubleshootIssue">
      <source xml:lang="en">Troubleshoot Issue...</source>
    </trans-unit>
    <trans-unit id="use insiders">
      <source xml:lang="en">This likely means that the issue has been addressed already and will be available in an upcoming release. You can safely use {0} insiders until the new stable version is available.</source>
    </trans-unit>
</body></file>
