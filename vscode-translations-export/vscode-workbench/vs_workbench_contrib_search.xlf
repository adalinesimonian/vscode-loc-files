      <source xml:lang="en">- `search.defaultViewMode`: Show results as list or tree.</source>
    </trans-unit>
    <trans-unit id="search.settingsHeader">
      <source xml:lang="en">Settings You Can Adjust ({0} opens Settings):</source>
    </trans-unit>
    <trans-unit id="search.settingsIntro">
      <source xml:lang="en">These settings affect how Search across files behaves.</source>
    </trans-unit>
    <trans-unit id="search.statusHeader">
      <source xml:lang="en">Current Search Status:</source>
    </trans-unit>
    <trans-unit id="search.statusIntro">
      <source xml:lang="en">You are searching across your workspace.</source>
    </trans-unit>
