    </trans-unit>
    <trans-unit id="search.macSettingHeader">
      <source xml:lang="en">Platform-Specific Setting (macOS only):</source>
    </trans-unit>
    <trans-unit id="search.noResults">
      <source xml:lang="en">No results found. Check your search term or adjust options below.</source>
    </trans-unit>
    <trans-unit id="search.noSearch">
      <source xml:lang="en">Type a search term to find results.</source>
    </trans-unit>
    <trans-unit id="search.optionCase">
      <source xml:lang="en">- Match Case: Only exact case matches are included.</source>
    </trans-unit>
    <trans-unit id="search.optionRegex">
      <source xml:lang="en">- Regular Expression: Use pattern matching for advanced searches.</source>
    </trans-unit>
