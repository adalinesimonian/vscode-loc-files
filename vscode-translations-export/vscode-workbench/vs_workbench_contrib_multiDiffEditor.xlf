    </trans-unit>
    <trans-unit id="multiDiffEditor.experimental.variant.cards">
      <source xml:lang="en">Use the compact card-based variant.</source>
    </trans-unit>
    <trans-unit id="multiDiffEditor.experimental.variant.noCards">
      <source xml:lang="en">Use the compact variant without cards.</source>
    </trans-unit>
