  <file original="src/vs/workbench/contrib/multiDiffEditor/common/multiDiffEditor" source-language="en" datatype="plaintext"><body>
    <trans-unit id="multiDiffEditor.experimental.fileList">
      <source xml:lang="en">Controls whether newly created multi diff editors support a list of the changed files alongside the diffs. Reload the window to apply this change to existing editors.</source>
    </trans-unit>
    <trans-unit id="multiDiffEditor.experimental.variant">
