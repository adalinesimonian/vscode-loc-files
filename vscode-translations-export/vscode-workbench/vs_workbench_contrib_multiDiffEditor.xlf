  <file original="src/vs/workbench/contrib/multiDiffEditor/browser/multiDiffEditorAccessibilityHelp" source-language="en" datatype="plaintext"><body>
    <trans-unit id="multiDiffEditor.fileListHelp.actions">
      <source xml:lang="en">Use Toggle Files in the editor toolbar or Command Palette to show or hide the changed files. The Files View &amp; Position submenu in the editor toolbar's More Actions menu switches between a list and a folder tree, and moves the files to the left or right of the diffs.</source>
    </trans-unit>
    <trans-unit id="multiDiffEditor.fileListHelp.agentsWindowActions">
      <source xml:lang="en">Use Toggle Details in the editor toolbar{0} to show or hide the changed files. The Files View &amp; Position submenu in the tab bar's More Actions menu switches between a list and a folder tree, and moves the files to the left or right of the diffs.</source>
    </trans-unit>
    <trans-unit id="multiDiffEditor.fileListHelp.navigation">
      <source xml:lang="en">Use the Up and Down Arrow keys to navigate files. In tree mode, use the Left and Right Arrow keys to collapse or expand folders.</source>
    </trans-unit>
    <trans-unit id="multiDiffEditor.fileListHelp.open">
      <source xml:lang="en">Press Enter to reveal the selected file and move focus to its diff.</source>
    </trans-unit>
    <trans-unit id="multiDiffEditor.fileListHelp.overview">
      <source xml:lang="en">You are in the changed files list of a multi diff editor.</source>
    </trans-unit>
</body></file>
