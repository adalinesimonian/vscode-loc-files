  <file original="src/vs/workbench/services/editor/common/editorResolverService" source-language="en" datatype="plaintext"><body>
    <trans-unit id="editor.diffEditorAssociations">
      <source xml:lang="en">Configure [glob patterns](https://aka.ms/vscode-glob-patterns) to editors for diff views (for example `"*.md": "vscode.markdown.preview.editor"`). These override `workbench.editorAssociations` for diffs.</source>
    </trans-unit>
    <trans-unit id="editor.editorAssociations">
      <source xml:lang="en">Configure [glob patterns](https://aka.ms/vscode-glob-patterns) to editors (for example `"*.hex": "hexEditor.hexedit"`). These have precedence over the default behavior.</source>
    </trans-unit>
    <trans-unit id="editor.hiddenEditorTypes">
      <source xml:lang="en">Configure editor types that are hidden from the editor type picker. The active editor type remains visible.</source>
    </trans-unit>
    <trans-unit id="editor.markdownDefaultEditorInAgentsWindow">
      <source xml:lang="en">Controls whether the Markdown editor is used as the default editor for Markdown files in the Agents window.</source>
    </trans-unit>
