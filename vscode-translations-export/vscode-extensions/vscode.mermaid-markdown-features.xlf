  <file original="extensions/vscode.mermaid-markdown-features/package" source-language="en" datatype="plaintext"><body>
    <trans-unit id="description">
      <source xml:lang="en">Adds Mermaid diagram support to built-in chats, Markdown previews, and notebooks.</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.resizable.description">
      <source xml:lang="en">Allow diagrams to be resized vertically by dragging the bottom edge.</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.mouseNavigation.enabled.always">
      <source xml:lang="en">Always enable mouse navigation on Mermaid diagrams.</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.controls.show.always">
      <source xml:lang="en">Always show zoom controls.</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.theme.dark.description">
      <source xml:lang="en">Built-in Mermaid theme for dark backgrounds.</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.theme.neutral.description">
      <source xml:lang="en">Built-in Mermaid theme using a neutral grayscale palette. Suitable for black and white prints.</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.theme.forest.description">
      <source xml:lang="en">Built-in Mermaid theme using shades of green.</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.theme.base.description">
      <source xml:lang="en">Built-in Mermaid theme. The only Mermaid theme that can be customized with theme variables.</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.controls.show.description">
      <source xml:lang="en">Controls showing UI controls on Mermaid diagrams.</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.mouseNavigation.enabled.description">
      <source xml:lang="en">Controls when mouse-based navigation is enabled on Mermaid diagrams.</source>
    </trans-unit>
    <trans-unit id="command.copySource.title">
      <source xml:lang="en">Copy Diagram Source</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.darkModeTheme.description">
      <source xml:lang="en">Default Mermaid theme for dark mode.</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.lightModeTheme.description">
      <source xml:lang="en">Default Mermaid theme for light mode.</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.languages.description">
      <source xml:lang="en">Default languages in Markdown.</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.mouseNavigation.enabled.never">
      <source xml:lang="en">Disable mouse navigation.</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.maxHeight.markdownDescription">
      <source xml:lang="en">Maximum height for diagrams. Must be a CSS value with units such as `80vh` or `400px`. Leave empty to try to automatically size diagrams based on their content.</source>
    </trans-unit>
    <trans-unit id="config.title">
      <source xml:lang="en">Mermaid</source>
    </trans-unit>
    <trans-unit id="displayName">
      <source xml:lang="en">Mermaid Markdown Features</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.theme.vscode.description">
      <source xml:lang="en">Mermaid theme derived from the current VS Code color theme.</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.controls.show.never">
      <source xml:lang="en">Never show controls.</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.mouseNavigation.enabled.alt">
      <source xml:lang="en">Only enable mouse navigation when holding down Alt (Option on macOS). Gestures such as pinch-to-zoom will still work without Alt.</source>
    </trans-unit>
    <trans-unit id="command.openInEditor.title">
      <source xml:lang="en">Open Diagram in Editor</source>
    </trans-unit>
    <trans-unit id="command.resetPanZoom.title">
      <source xml:lang="en">Reset Pan and Zoom</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.controls.show.onHoverOrFocus">
      <source xml:lang="en">Show zoom controls when hovering over or focusing a diagram.</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.theme.default.description">
      <source xml:lang="en">The default built-in Mermaid theme. Works well with light backgrounds.</source>
    </trans-unit>
    <trans-unit id="config.markdown-mermaid.maxTextSize.description">
      <source xml:lang="en">The maximum allowed size of the user&apos;s text diagram.</source>
    </trans-unit>
  </body></file>
